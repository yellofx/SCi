# Copy to .env and fill in. .env is gitignored — secrets never enter the repo.

# Gateway auth (agent -> litellm). Any non-empty value for local use.
LITELLM_MASTER_KEY=sk-local-dev-change-me

# --- Application secrets, injected at RUNTIME (never baked into target/) ---
DB_URL=jdbc:postgresql://db:5432/citizens
DB_USERNAME=app
DB_PASSWORD=change-me-runtime-only

# --- Remote model (optional; only if you use remote-coder / remote-claude) -
REMOTE_API_BASE=https://inference.your-eu-cloud.example/v1
REMOTE_API_KEY=
# ANTHROPIC_API_KEY=
